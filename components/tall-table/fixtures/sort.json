{
  "about": "sort: the cycle a click on a sortable header's arrow goes through, by the column's kind, and the order a source answers in. See README.md.",
  "cycle": [
    { "kind": "text", "clicks": ["ascending", "descending", null], "why": "A to Z is the first wish for names." },
    { "kind": "integer", "clicks": ["descending", "ascending", null], "why": "Every kind but text: the largest first." },
    { "kind": "float", "clicks": ["descending", "ascending", null] },
    { "kind": "decimal", "clicks": ["descending", "ascending", null] },
    { "kind": "date", "clicks": ["descending", "ascending", null], "why": "The latest first." },
    { "kind": "timestamp", "clicks": ["descending", "ascending", null] },
    { "kind": "boolean", "clicks": ["descending", "ascending", null], "why": "true first." }
  ],
  "cycle_controls": ["descending-first"],
  "orders": [
    {
      "why": "Numbers with ties and NULLs: ties in the source's own order both ways (a stable sort, not a reversed one), NULLs last both ways.",
      "values": [3, null, 1, 3, 2, null, 1],
      "ascending": [2, 6, 4, 0, 3, 1, 5],
      "descending": [0, 3, 4, 2, 6, 1, 5]
    },
    {
      "why": "Negatives and fractions compare as numbers, not as text.",
      "values": [0.5, -2, 10, -0.25, 0.5],
      "ascending": [1, 3, 0, 4, 2],
      "descending": [2, 0, 4, 3, 1]
    },
    {
      "why": "Text by its bytes (DuckDB's default collation): the empty text first, capitals before lower case; NULL last.",
      "values": ["beta", "Alpha", null, "alpha", "beta", ""],
      "ascending": [5, 1, 3, 0, 4, 2],
      "descending": [0, 4, 3, 1, 5, 2]
    },
    {
      "why": "Booleans: false before true.",
      "values": [true, false, true, false],
      "ascending": [1, 3, 0, 2],
      "descending": [0, 2, 1, 3]
    },
    {
      "why": "Every value NULL: the source's own order.",
      "values": [null, null, null],
      "ascending": [0, 1, 2],
      "descending": [0, 1, 2]
    }
  ],
  "order_controls": ["nulls-first", "ties-reversed"]
}
