# The tall table's recipes. Run from the repo root: `just tall-table <recipe>`.
# Its bare host (host/) is where each feature's own cost is measured
# (PLAN.md, "Measuring a feature"); it's never deployed.

component_dir := source_directory()
root := source_directory() / "../.."
host_web := component_dir / "host/web"
target_dir := root / "target/wasm32-unknown-unknown"

# The bare host's wasm (debug) and its Vite dev server with COOP/COEP.
# `?shape=wide` for 500 float columns, `?delay=<ms>` to hold each page read.
# `features` are the host's (`custom-cells`: `?cells=heat|bars|color`;
# `live`: `?live=<updates/s>`; both: `?flash`; `follow`:
# `?rows=<n>&append=<rows/s>&follow`).
dev features="": (wasm "debug" features)
    npm run dev --workspace @seiza/tall-table-host

# The bare host's release build: wasm (+ wasm-opt), Vite build, then asset
# sizes (raw, gzip, brotli 11). `features` are the host's, written to
# dist/build.json for the scripts (the base without any).
build features="": (wasm "release" features)
    npm run build --workspace @seiza/tall-table-host
    node {{root}}/shared-web/scripts/asset-sizes.ts {{host_web}}/dist
    printf '{"features":"%s"}\n' '{{features}}' > {{host_web}}/dist/build.json

# Serve the bare host's release build (brotli), as the scripts do.
preview:
    npm run preview --workspace @seiza/tall-table-host

# Compile the bare host alone (`-p`: Cargo unifies features across the
# packages in one build) and generate its JS bindings into host/web/pkg/,
# with the apps' wasm-opt flags in release, with the host's `features`.
wasm profile="debug" features="":
    cargo build -p tall-table-host --target wasm32-unknown-unknown {{ if profile == "release" { "--release" } else { "" } }} {{ if features != "" { "--features " + features } else { "" } }}
    wasm-bindgen {{target_dir}}/{{profile}}/tall_table_host.wasm --out-dir {{host_web}}/pkg --target web
    {{ if profile == "release" { "wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals --enable-reference-types --enable-multivalue --enable-threads " + host_web + "/pkg/tall_table_host_bg.wasm -o " + host_web + "/pkg/tall_table_host_bg.wasm" } else { "true" } }}

# The bare host's wasm: raw (cargo's output), after wasm-bindgen and wasm-opt, and
# brotli 11 (built by the `wasm` recipe), against the observatory's GPUI contender's shipped wasm when
# it's built (`just observatory gpui-build`); fails if an engine or the
# observation panel links. --label writes perf/results/<date>-<label>.json.
size *args:
    node {{component_dir}}/perf/size.ts {{args}}

# The base's frame work in the bare host's release build, per shape (narrow,
# wide): a vertical scroll, a vertical fling, in the wide shape a horizontal
# fling, and with `resize` built a resize drag (the first float column's
# edge out 200 px and back, twice, a move every 8 ms), reference +
# throttled, cold, median of 10. Per-frame work from Chromium's trace,
# cross-checked by `workRecorder`; late frames; frame intervals; visible
# cells. --runs, --shape, --profile, --label
# (writes perf/results/<date>-<label>.json). Run `just tall-table build`
# first.
perf *args:
    node {{component_dir}}/perf/perf.ts {{args}}

# `live` in the bare host's release build, cold, median of 10, at --rate
# updates a second (1000): the feed's batch of visible rows invalidated →
# the first frame drawing their re-read (the table's share of update →
# pixel), then, in a second window, per-frame work and late frames under
# the feed. --flash (a build with custom-cells too) flashes every float
# column. --runs, --profile, --seconds, --label. Run
# `just tall-table build live` (or `live,custom-cells`) first.
live *args:
    node {{component_dir}}/perf/live.ts {{args}}

# `follow` in the bare host's release build, cold, median of 10, the tail
# feed at --rate rows a second (10000) from 1,000 rows, following: append
# → pixel (a batch sent → the first tail frame drawing it), the presented
# frames with placeholder rows, reads a second and drained reads; then, in
# a second window, per-frame work and late frames; then scroll-back during
# the feed (a wheel up → the first frame there, and → its rows real).
# --runs, --profile, --seconds, --inputs, --warmup, --label. Run
# `just tall-table build follow` first.
follow *args:
    node {{component_dir}}/perf/follow.ts {{args}}

# The bare host on its release build in Chromium, Firefox, and WebKit: it
# loads, fills, and scrolls in both shapes (a smoke check, not a manual
# one), and with each feature built runs its own checks (with `resize`, a
# drag, a fit, and a narrowing at the right end, in both shapes).
# --browsers. Run `just tall-table build` first.
smoke *args:
    node {{component_dir}}/perf/smoke.ts {{args}}

# Native tests: the table's (page cache, scroll model, float fitting, cell
# text, the fixtures) and the host's rows and feeds, with every feature
# off, each on alone (`custom-cells`: the paint fixture; `live`: the
# re-reads and the paging fixture's live scenarios; `follow`, which turns
# on `live`: the flag, the pin, and the paging fixture's follow scenarios;
# `resize`: the drag, the fit, and the cell fixture's resize section;
# `select`: the selection fixture, the presses, drag, keys, and drawing),
# and all on. The bridge has none: its
# JS values are wasm-only, and Tycho's checks (`just tycho table`, `cells`),
# the observatory's cell fixture, and `smoke` read every field it writes.
test:
    cargo test -p seiza-tall-table -p tall-table-host
    cargo test -p seiza-tall-table -p tall-table-host --features tall-table-host/custom-cells
    cargo test -p seiza-tall-table -p tall-table-host --features tall-table-host/live
    cargo test -p seiza-tall-table -p tall-table-host --features tall-table-host/custom-cells,tall-table-host/live
    cargo test -p seiza-tall-table -p tall-table-host --features tall-table-host/follow
    cargo test -p seiza-tall-table -p tall-table-host --features tall-table-host/custom-cells,tall-table-host/follow
    cargo test -p seiza-tall-table -p tall-table-host --features tall-table-host/resize
    cargo test -p seiza-tall-table -p tall-table-host --features tall-table-host/select
    cargo test -p seiza-tall-table -p tall-table-host --features tall-table-host/custom-cells,tall-table-host/follow,tall-table-host/resize,tall-table-host/select

# Writes fixtures/paint.json's expected colors from Chromium's
# color-mix(in oklab) and its bars from their formula (--check compares).
paint-fixture *args:
    node {{component_dir}}/perf/paint-fixture.ts {{args}}

# No milestone references outside the history files (check-terms), fmt,
# clippy for the table, the bridge, and the host (wasm32 with no features
# and with every one, native with every one, with -D warnings), and
# TypeScript (the host's page and perf/).
lint:
    cd {{root}} && node shared-web/scripts/check-terms.ts
    cargo fmt --all --check
    cargo clippy -p tall-table-host -p tall-table-bridge -p seiza-tall-table --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p tall-table-host -p tall-table-bridge -p seiza-tall-table --target wasm32-unknown-unknown --all-features -- -D warnings
    cargo clippy -p tall-table-host -p tall-table-bridge -p seiza-tall-table --all-features --all-targets -- -D warnings
    npm run typecheck --workspace @seiza/tall-table-host
