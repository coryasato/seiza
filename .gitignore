# Rust
target/

# JS
node_modules/
dist/
apps/*/web/dist-placeholder/
*.tsbuildinfo
.vite/

# wasm-bindgen / wasm-pack output
pkg/
# A contender's feature-level builds (`contenders/scenarios.ts`): pkg-<level>/, dist-<level>/
apps/observatory/contenders/*/*/web/pkg-*/
apps/observatory/contenders/*/*/web/dist-*/

# Cloudflare
.wrangler/
.dev.vars
.dev.vars.*

# Env / secrets
# Private notes kept out of the public repo (cost and abuse exposure)
apps/*/docs/private/
docs/private/
.env
.env.*
!.env.example

# App data: raw fetches and generated datasets (MANIFEST.json and fixtures-src/ stay committed)
apps/*/data/raw/
apps/*/data/*.parquet
apps/*/data/*.bin
apps/*/data/fixtures/*.csv
apps/*/data/drop/
apps/*/data/bench/
# The wide-grid spike's values, exported from the wide sheet's file (spike/wide-data.ts)
apps/observatory/spike/public/wide/
# The feed spike's Rust fold, built from spike/fold/ (feed-run.ts builds it)
apps/observatory/spike/public/fold/
# The admin table's script faces, fetched by pin (contenders/fonts/fetch.ts)
apps/observatory/contenders/fonts/faces/
# The fonts spike's faces and output (spike/fonts/fetch-faces.sh, fonts-spike.ts)
apps/observatory/spike/fonts/faces/
apps/observatory/spike/fonts/out-*/

# DuckDB extensions, downloaded and checked against pinned hashes (engines/duckdb/web/duckdb-extensions.json)
apps/*/web/public/duckdb-ext/
apps/*/contenders/*/*/web/public/duckdb/

# Perf: raw Playwright traces (everything else under perf/results/ is committed)
apps/*/perf/results/raw/
components/*/perf/results/raw/
playwright-report/
test-results/
blob-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editors
.DS_Store
Thumbs.db
.idea/
*.swp
*~

# Claude Code local settings
.claude/settings.local.json
