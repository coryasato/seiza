# Tycho recipes. Run from the repo root: `just tycho <recipe>`.

app_dir := source_directory()
root := source_directory() / "../.."
web := app_dir / "web"
pkg := web / "pkg"
target_dir := root / "target/wasm32-unknown-unknown"

worker_scripts := app_dir / "worker/scripts"

# Build wasm (debug) and start the Vite dev server with COOP/COEP.
dev: (wasm "debug") extensions
    npm run dev --workspace @seiza/tycho-web

# Release wasm (+ wasm-opt), Vite build, then report asset sizes, and the
# page's weight before first paint (the document, the entry JS, the app wasm,
# the UI font; reported, not gated). DuckDB's wasm bundles are over
# Cloudflare's 25 MiB asset limit; they go to R2.
build: (wasm "release") extensions
    npm run build --workspace @seiza/tycho-web
    node {{root}}/shared-web/scripts/asset-sizes.ts {{web}}/dist --r2 duckdb-eh --r2 duckdb-mvp --first-paint index.html --first-paint assets/index- --first-paint tycho_bg --first-paint IBMPlexSans-Regular

# Serve the release build with the same headers.
preview:
    npm run preview --workspace @seiza/tycho-web

# Deploy to Cloudflare: release build, then upload the oversize DuckDB wasm
# to R2 if changed, `wrangler deploy`, and check production
# (worker/scripts/deploy.ts). Not until the rebuild ships: production keeps
# the deployed app and its samples (docs/DECISIONS.md, "Hosting", 2026-11-23),
# so it refuses without --rebuild-ships, that deploy's flag (--dry-run aside). Needs `wrangler login` and TYCHO_R2_PROFILE (an
# AWS CLI profile with the R2 bucket's S3 keys). Flags: --dry-run, --skip-check.
deploy *args: build
    node {{worker_scripts}}/deploy.ts {{args}}

# Production: pause the samples (docs/hosting.md, "Abuse guards"): sets the
# Worker secret DATA_PAUSED. Only production's Worker, the app as deployed
# until the rebuild ships, reads it: its /data/* answers 503 and its page
# says to drop a file instead, so nothing reads R2. A Worker from this tree
# doesn't read it (it serves no /data/*), so after the rebuild deploys this
# does nothing. Takes effect in seconds, survives deploys. Needs `wrangler login`.
# Tycho's Worker alone: Kirkwood has its own switch (`just kirkwood pause`).
pause: (paused "1")

# Production: serve the samples again after `just tycho pause`.
resume: (paused "0")

# DATA_PAUSED on Tycho's Worker.
[private]
paused value:
    cd {{app_dir}}/worker && printf {{value}} | {{root}}/node_modules/.bin/wrangler secret put DATA_PAUSED

# Download the DuckDB extensions the engine pins
# (engines/duckdb/web/duckdb-extensions.json) into web/public/duckdb-ext/,
# checking each SHA-256. A no-op once they're there.
extensions:
    node {{root}}/engines/duckdb/web/scripts/extensions.ts {{web}}/public

# The test files: the CSV fixture (data/fixtures/asteroids.csv), and the
# drop-test files (data/drop/), all gitignored, from the observatory's full
# asteroid sample (`just observatory data --only asteroids` first): the
# sample repeated to ~100 MB and ~1 GB, the 1 GB one in three row-group
# layouts, and the CSV fixture repeated to ~1 GB. Local only: dropped from disk, like a
# visitor's file, by hand (the 1 GB memory check, perf/CLAUDE.md) and by the
# checks the rebuild writes again. Pass name parts to build only some, e.g.
# `just tycho drop-files csv`.
drop-files *args: data-deps
    node {{app_dir}}/data/drop_files.ts {{args}}

# Install drop-files' dependencies (native DuckDB, tens of MB).
data-deps:
    npm install --prefix {{app_dir}}/data --no-audit --no-fund --silent

# The Worker's checks: its unit tests (fakes of the build and the bucket),
# then against `wrangler dev` on the release build (`just tycho build`
# first), its local R2 filled with the build's two DuckDB wasm bundles: each
# served whole, byte for byte, with its headers; /data/* a 404.
worker-check:
    node --test {{app_dir}}/worker/test/index.test.ts
    node {{worker_scripts}}/check.ts

# Lint, release build, then: no home-directory path in the shipped wasm (the
# root release profile's trim-paths), and the wasm's size gate: fails if the
# app wasm (brotli) grows more than 15% over perf/baseline.json without a row
# in perf/budget-notes.md (perf/size.ts). Tycho times nothing here: its
# measurements are retired (docs/DECISIONS.md, "Perf tooling and budgets").
check: lint build
    node {{root}}/shared-web/perf/home-paths.ts {{web}}/dist/assets/tycho_bg-*.wasm
    node {{app_dir}}/perf/size.ts

# The home-path check's control: Tycho built without trim-paths (a cold build
# in target/untrimmed/) must fail it, and the release build must pass.
home-paths: build
    node {{root}}/shared-web/perf/home-paths.ts {{web}}/dist/assets/tycho_bg-*.wasm --control tycho

# fmt, clippy (wasm target and native host; Tycho, seiza, the DuckDB engine, and the table component), TypeScript (host, perf, data, and worker scripts, shared-web scripts, the DuckDB engine's package), plus no milestone references outside the history files (check-terms).
lint:
    cd {{root}} && node shared-web/scripts/check-terms.ts
    cargo fmt --all --check
    cargo clippy -p tycho -p seiza -p seiza-duckdb -p seiza-tall-table --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p tycho -p seiza -p seiza-duckdb -p seiza-tall-table --all-features --all-targets -- -D warnings
    npm run typecheck --workspace @seiza/tycho-web
    @if [ -d {{app_dir}}/data/node_modules ]; then npx tsc -p {{app_dir}}/data; else echo "skipped data/ typecheck: its deps install with \`just tycho data-deps\`"; fi

# Compile the crate and generate JS bindings into web/pkg/.
wasm profile="debug":
    cargo build -p tycho --target wasm32-unknown-unknown {{ if profile == "release" { "--release" } else { "" } }}
    wasm-bindgen {{target_dir}}/{{profile}}/tycho.wasm --out-dir {{pkg}} --target web
    {{ if profile == "release" { "wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals --enable-reference-types --enable-multivalue --enable-threads " + pkg + "/tycho_bg.wasm -o " + pkg + "/tycho_bg.wasm" } else { "true" } }}

# Cross-browser shell check (Chromium, Firefox, WebKit) against a running
# server: a first frame appears (its time printed, stored nowhere),
# cross-origin isolated, no console errors, resizes followed; on a release
# build (the preview's URL), no request outside the first-paint set starts
# before the first frame (Chromium). --control must fail that part.
smoke url="http://localhost:5173/" *args:
    node {{app_dir}}/perf/smoke.ts {{url}} {{args}}
