# Tycho recipes. Run from the repo root: `just tycho <recipe>`.

app_dir := source_directory()
root := source_directory() / "../.."
web := app_dir / "web"
pkg := web / "pkg"
target_dir := root / "target/wasm32-unknown-unknown"

worker_scripts := app_dir / "worker/scripts"

# Build wasm (debug) and start the Vite dev server with COOP/COEP, plus the
# Worker (`wrangler dev`, local R2) that Vite proxies /data/* to.
dev: (wasm "debug") extensions
    node {{worker_scripts}}/with-worker.ts npm run dev --workspace @seiza/tycho-web

# Release wasm (+ wasm-opt), Vite build, then report asset sizes. DuckDB's
# wasm bundles are over Cloudflare's 25 MiB asset limit; they go to R2 (M8).
build: (wasm "release") extensions
    npm run build --workspace @seiza/tycho-web
    node {{root}}/shared-web/scripts/asset-sizes.ts {{web}}/dist --r2 duckdb-eh --r2 duckdb-mvp

# Serve the release build with the same headers, plus the Worker for /data/*.
preview:
    node {{worker_scripts}}/with-worker.ts npm run preview --workspace @seiza/tycho-web

# Download the pinned DuckDB extensions (web/duckdb-extensions.json) into
# web/public/duckdb-ext/, checking each SHA-256. A no-op once they're there.
extensions:
    node {{web}}/scripts/extensions.ts

# Build the sample data (fetch once, then prep.sql → Parquet + CSV fixture +
# MANIFEST.json) and load the Parquet into the local R2 that `wrangler dev`
# serves. `just tycho data --refresh` fetches the catalog again. Native DuckDB
# (data/package.json, its own lockfile) is installed here, not by `just setup`.
data *args: data-deps
    node {{app_dir}}/data/prep.ts asteroids {{args}}
    cd {{app_dir}}/worker && {{root}}/node_modules/.bin/wrangler r2 object put tycho-data/asteroids.parquet --file ../data/asteroids.parquet --local

# The drop-test files (data/drop/, gitignored): asteroids.parquet repeated
# to ~100 MB and ~1 GB, the 1 GB one in three row-group layouts (M5), and the
# CSV fixture repeated to ~1 GB (M6). Local only: perf/drop.ts and
# perf/csv.ts open them from disk, like a visitor's file. Pass name parts to
# build only some, e.g. `just tycho drop-files csv`.
drop-files *args: data-deps
    node {{app_dir}}/data/drop_files.ts {{args}}

# Install the data scripts' dependencies (native DuckDB, tens of MB).
data-deps:
    npm install --prefix {{app_dir}}/data --no-audit --no-fund --silent

# /data/* byte-range checks: the Worker's unit tests (a strict fake R2), then
# against `wrangler dev` (HEAD, 206s, 416s, 404s, headers, and the whole
# file's SHA-256 against MANIFEST.json).
worker-check:
    node --test {{app_dir}}/worker/test/index.test.ts
    node {{worker_scripts}}/check.ts

# M3 sample checks on the release build (vite preview + wrangler dev): click →
# schema time, bytes transferred, click before the engine is ready. Writes
# perf/results/<date>-<label>.json. Run `just tycho build` first.
sample *args:
    node {{app_dir}}/perf/sample.ts {{args}}

# M4 table checks on the release build: file → first rows, scrollbar jump to
# 90%, last row vs count(*), fling frame times, steady-scroll placeholders.
# `--sweep` runs page size × prefetch instead; `--memory` adds two full passes
# and records memory. Writes perf/results/<date>-<label>.json. Run
# `just tycho build` first.
table *args:
    node {{app_dir}}/perf/table.ts {{args}}

# M7 panel checks on the release build: every observation-panel value
# against an independent measurement (page timings, an rAF recorder, a
# work-time wrapper, /data/ bytes at the server), and the fling with the
# panel open and closed (reference + throttled). Writes
# perf/results/<date>-<label>.json. Run `just tycho build` first.
panel *args:
    node {{app_dir}}/perf/panel.ts {{args}}

# M5 drop checks on the release build: drop a ~1 GB Parquet → schema and
# first rows, 100 MB vs 1 GB memory, unsupported files, a drop superseding a
# load, and the file dialog in Chromium/Firefox/WebKit. Needs
# `just tycho drop-files`. Writes perf/results/<date>-<label>.json.
drop *args:
    node {{app_dir}}/perf/drop.ts {{args}}

# M6 CSV checks on the release build: drop a ~1 GB CSV → schema and first
# rows, row-count updates ≤ 500 ms apart, a fling while it loads, the final
# count (reference + throttled); the fixture's count and tricky rows; a drop
# replacing a loading CSV (its tables dropped); Firefox and WebKit. Needs
# `just tycho drop-files`. Writes perf/results/<date>-<label>.json.
csv *args:
    node {{app_dir}}/perf/csv.ts {{args}}

# M6 ingest experiment: raw-file queries vs whole-file and chunked ingest of
# the ~1 GB CSV, by chunk size, compression, and one table vs one per chunk
# (see perf/results/2026-09-30-m6.md).
ingest *args:
    node {{app_dir}}/perf/ingest.ts {{args}}

# M4 paging experiment: LIMIT/OFFSET vs file_row_number vs ingest, at several
# row-group sizes (bench/ files in local R2; see perf/results/2026-09-25-m4.md).
paging *args:
    node {{app_dir}}/perf/paging.ts {{args}}

# Lint, release build, then the perf budgets: fails if reference TTFP regresses
# more than 10% from perf/baseline.json, or the wasm grows more than 15% (brotli)
# without a row in perf/budget-notes.md.
check: lint build
    node {{app_dir}}/perf/perf.ts --check

# Cold-load suite (reference + throttled, median of 10) on the release build in
# web/dist; writes perf/results/<date>-<label>.json. Run `just tycho build` first.
# Extra flags pass through, e.g. `just tycho perf --label m2 --runs 5`.
perf *args:
    node {{app_dir}}/perf/perf.ts {{args}}

# Engine self-test (M2): SELECT 42, every shown type, and cancel, run from Rust
# in the release build (`?selftest`). Chromium --runs times, Firefox and WebKit
# once; writes perf/results/<date>-<label>.json. Run `just tycho build` first.
engine *args:
    node {{app_dir}}/perf/engine.ts {{args}}

# fmt, clippy (wasm target and native host), and TypeScript (host, perf, data, and worker scripts, shared-web scripts).
lint:
    cargo fmt --all --check
    cargo clippy -p tycho -p seiza --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p tycho -p seiza -- -D warnings
    npm run typecheck --workspace @seiza/tycho-web
    @if [ -d {{app_dir}}/data/node_modules ]; then npx tsc -p {{app_dir}}/data; else echo "skipped data/ typecheck: its deps install with \`just tycho data\` (or \`just tycho data-deps\`)"; fi

# Compile the crate and generate JS bindings into web/pkg/.
wasm profile="debug":
    cargo build -p tycho --target wasm32-unknown-unknown {{ if profile == "release" { "--release" } else { "" } }}
    wasm-bindgen {{target_dir}}/{{profile}}/tycho.wasm --out-dir {{pkg}} --target web
    {{ if profile == "release" { "wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals --enable-reference-types --enable-multivalue --enable-threads " + pkg + "/tycho_bg.wasm -o " + pkg + "/tycho_bg.wasm" } else { "true" } }}

# Cross-browser shell check (Chromium, Firefox, WebKit) against a running server.
smoke url="http://localhost:5173/":
    node {{app_dir}}/perf/smoke.ts {{url}}
