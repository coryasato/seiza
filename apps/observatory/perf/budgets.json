{
  "about": "Every budget the Observatory's perf scripts enforce (limits, read through shared-web/perf/'s budgetLimits()) and every number its docs show (metrics, rendered by `just observatory report`). Source forms are documented at the top of shared-web/scripts/report.ts.",
  "app": "Observatory",
  "exclude": [
    "*-control*",
    "*-ab.json",
    "*-ab-*",
    "*-before*",
    "*-smoke-*",
    "*-m4-b-usable-loaded.json"
  ],
  "limits": {
    "gpui": {
      "ttfpOverBaseline": {
        "value": 0.1,
        "what": "`check`: the GPUI contender's reference TTFP over perf/baseline.json's, as a fraction"
      },
      "wasmOverBaseline": {
        "value": 0.15,
        "what": "`check`: the GPUI contender's wasm (brotli) over the baseline's, as a fraction"
      }
    },
    "tanstack": {
      "firstPaintJsOverBaseline": {
        "value": 0.1,
        "what": "`check`: the TanStack contender's first-paint JS (the entry and its static imports, brotli) over perf/baseline.json's, as a fraction"
      },
      "dataLayerJsOverBaseline": {
        "value": 0.1,
        "what": "`check`: the TanStack contender's after-paint data layer with Arrow (brotli) over perf/baseline.json's, as a fraction"
      }
    }
  },
  "metrics": [
    {
      "id": "gpui-ttfp",
      "label": "GPUI contender: time to first paint",
      "unit": "ms",
      "budget": {
        "overBaseline": "gpui.ttfpOverBaseline",
        "baseline": "ttfpMs.reference"
      },
      "gate": "`check`",
      "local": [
        [
          {
            "glob": "*-gpui-cold.json",
            "path": "ttfpMs.reference"
          },
          {
            "baseline": "ttfpMs.reference"
          }
        ]
      ],
      "show": [
        "plan"
      ]
    },
    {
      "id": "gpui-ttfp-throttled",
      "label": "GPUI contender: time to first paint, throttled",
      "unit": "ms",
      "gate": "recorded",
      "local": [
        [
          {
            "glob": "*-gpui-cold.json",
            "path": "ttfpMs.throttled"
          },
          {
            "baseline": "ttfpMs.throttled"
          }
        ]
      ],
      "show": [
        "plan"
      ]
    },
    {
      "id": "gpui-wasm",
      "label": "GPUI contender: wasm (brotli)",
      "unit": "KiB",
      "budget": {
        "overBaseline": "gpui.wasmOverBaseline",
        "baseline": "wasmBrotliKiB"
      },
      "gate": "`check`",
      "local": [
        [
          {
            "glob": "*-gpui-cold.json",
            "path": "wasmBrotliKiB"
          },
          {
            "baseline": "wasmBrotliKiB"
          }
        ]
      ],
      "show": [
        "plan"
      ]
    },
    {
      "id": "tanstack-first-paint-js",
      "label": "TanStack contender: first-paint JS (brotli)",
      "unit": "KiB",
      "budget": {
        "overBaseline": "tanstack.firstPaintJsOverBaseline",
        "baseline": "tanstackJsBrotliKiB.firstPaint"
      },
      "gate": "`check`",
      "local": [
        [
          {
            "glob": "*-tanstack-sizes.json",
            "path": "firstPaintJsBrotliKiB"
          },
          {
            "baseline": "tanstackJsBrotliKiB.firstPaint"
          }
        ]
      ],
      "show": [
        "plan"
      ]
    },
    {
      "id": "tanstack-data-layer-js",
      "label": "TanStack contender: data layer and Arrow, after first paint (brotli)",
      "unit": "KiB",
      "budget": {
        "overBaseline": "tanstack.dataLayerJsOverBaseline",
        "baseline": "tanstackJsBrotliKiB.dataLayer"
      },
      "gate": "`check`",
      "local": [
        [
          {
            "glob": "*-tanstack-sizes.json",
            "path": "dataLayerJsBrotliKiB"
          },
          {
            "baseline": "tanstackJsBrotliKiB.dataLayer"
          }
        ]
      ],
      "show": [
        "plan"
      ]
    },
    {
      "id": "usable-reference",
      "label": "Time to first usable (probe-confirmed), reference",
      "unit": "ms",
      "gate": "recorded",
      "local": [
        {
          "glob": "*-usable.json",
          "path": "profiles.reference.gpui.summary.usableMs"
        },
        {
          "glob": "*-usable.json",
          "path": "profiles.reference.tanstack.summary.usableMs"
        }
      ],
      "show": [
        "readme"
      ],
      "headline": "GPUI / TanStack: first usable {local}"
    },
    {
      "id": "usable-throttled",
      "label": "Time to first usable (probe-confirmed), throttled, CPU 4× and Fast 4G",
      "unit": "ms",
      "gate": "recorded",
      "local": [
