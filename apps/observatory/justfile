# Observatory recipes. Run from the repo root: `just observatory <recipe>`.

app_dir := source_directory()
root := source_directory() / "../.."
gpui_web := app_dir / "contenders/tall-table/gpui/web"
tanstack_web := app_dir / "contenders/tall-table/tanstack/web"
target_dir := root / "target/wasm32-unknown-unknown"

page_web := app_dir / "web"

# The page's Vite dev server, with COOP/COEP, at /observatory/ and
# /observatory/tall-table/. Its frames load the contenders' release builds
# (`gpui-build`, `tanstack-build` first), with the engine, the font, and
# the data file.
dev:
    npm run dev --workspace @seiza/observatory-web

# The page's release build (one prerendered HTML file per route), then
# asset sizes.
build:
    npm run build --workspace @seiza/observatory-web
    node {{root}}/shared-web/scripts/asset-sizes.ts {{page_web}}/dist

# Serve the page's release build (brotli), its frames' builds, the engine,
# the font, and the data, as the deploy will.
preview:
    npm run preview --workspace @seiza/observatory-web

# The page on its release build, with both contenders in its frames, in
# Chromium: first paint (paint timing) and its first-paint JS, cold,
# reference + throttled, median of 10; nothing but its HTML, CSS, entry, and
# font before first paint, the frame and the metrics module after it; the
# toggle disabled until the shown contender fills, a flip destroying the
# frame, ?side=, and the theme into both contenders live. --check: reference
# only, against perf/baseline.json (perf/budgets.json's limits); --runs,
# --label, --write-baseline, --reference-only. Run `just observatory
# gpui-build`, `tanstack-build`, and `build` first.
page *args:
    node {{app_dir}}/perf/page.ts {{args}}

# The GPUI contender (contenders/tall-table/gpui/): build its wasm (debug)
# and start its Vite dev server with COOP/COEP, at /observatory/. Serves the
# data file (`just observatory data`) by range at /observatory/data/.
gpui-dev: (gpui-wasm "debug") gpui-extensions
    npm run dev --workspace @seiza/observatory-tall-table-gpui

# The GPUI contender's release build: wasm (+ wasm-opt), Vite build, then
# asset sizes. DuckDB's two wasm bundles are over Cloudflare's 25 MiB asset
# limit; where they're hosted is decided at the deploy.
gpui-build: (gpui-wasm "release") gpui-extensions
    npm run build --workspace @seiza/observatory-tall-table-gpui
    node {{root}}/shared-web/scripts/asset-sizes.ts {{gpui_web}}/dist --r2 duckdb-eh --r2 duckdb-mvp

# Serve the GPUI contender's release build (brotli, as production will), with the data file.
gpui-preview:
    npm run preview --workspace @seiza/observatory-tall-table-gpui

# Compile the GPUI contender alone (`-p`: Cargo unifies features across the
# packages in one build) and generate its JS bindings into web/pkg/.
gpui-wasm profile="debug":
    cargo build -p tall-table-gpui --target wasm32-unknown-unknown {{ if profile == "release" { "--release" } else { "" } }}
    wasm-bindgen {{target_dir}}/{{profile}}/tall_table_gpui.wasm --out-dir {{gpui_web}}/pkg --target web
    {{ if profile == "release" { "wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals --enable-reference-types --enable-multivalue --enable-threads " + gpui_web + "/pkg/tall_table_gpui_bg.wasm -o " + gpui_web + "/pkg/tall_table_gpui_bg.wasm" } else { "true" } }}

# Download the DuckDB extensions the engine pins into the GPUI contender's
# public/duckdb/ (served at /observatory/duckdb/), checking each SHA-256.
gpui-extensions:
    node {{root}}/engines/duckdb/web/scripts/extensions.ts {{gpui_web}}/public duckdb

# The TanStack contender (contenders/tall-table/tanstack/): its Vite dev
# server with COOP/COEP, at /observatory/, with the data file by range.
tanstack-dev: tanstack-extensions
    npm run dev --workspace @seiza/observatory-tall-table-tanstack

# The TanStack contender's release build, then asset sizes. DuckDB's
# bundles and extensions land in dist/duckdb/, the same files as the GPUI
# contender's (`engine-files` checks it). The build fails if Arrow or
# DuckDB's JS reaches a first-paint chunk (contenders/engine.ts).
tanstack-build: tanstack-extensions
    npm run build --workspace @seiza/observatory-tall-table-tanstack
    node {{root}}/shared-web/scripts/asset-sizes.ts {{tanstack_web}}/dist --r2 duckdb-eh --r2 duckdb-mvp

# Serve the TanStack contender's release build (brotli), with the data file.
tanstack-preview:
    npm run preview --workspace @seiza/observatory-tall-table-tanstack

# The TanStack contender's theme (tanstack/web/src/theme.css): the colors
# the tall table draws with, as CSS variables, light and dark, generated
# natively from gpui-kit's default theme at the pin. --check fails if the
# committed file differs.
theme-css *args:
    cargo run -q -p tall-table-gpui --example theme_css -- {{args}}

# The TanStack contender's view on its release build: it opens the file
# and End reaches the last row (its number count(*), its key the file's
# last, from native DuckDB) in Chromium, Firefox, and WebKit; the engine
# starts in a hidden frame and a hidden page. --gpui compares the columns
# with the GPUI contender's build; --shots <dir> writes screenshots;
# --browsers, --label. Needs `just observatory data`; run `just
# observatory tanstack-build` first.
tanstack-view *args:
    node {{app_dir}}/perf/tanstack-view.ts {{args}}

# The TanStack contender's base-level parity with the tall table, item by
# item against the component's README, on its release build (`?probe`):
# the keys (and the GPUI contender's, the same keys), Shift+wheel, a track
# press, the drag settle, the tooltip, and the focus ring, in Chromium,
# Firefox, and WebKit. --firefox adds a headed Firefox's track press
# (classic scrollbars); --browsers, --label. Needs `just observatory data`;
# run `just observatory tanstack-build` and `gpui-build` first.
tanstack-parity *args:
    node {{app_dir}}/perf/tanstack-parity.ts {{args}}

# The TanStack contender on its release build: its prerendered first
# screen hydrated in place, first usable confirmed by the probe key (and its
# control: a key before the hydration commit changes nothing), and the
# contract (marks in order, the engine started after first paint and
# usable, each filled mark's cells painted right after it, state, targets,
# and Element Timing only with ?measure, the replay hooks, the marks
# relayed from a frame), in Chromium. --label writes perf/results/. Needs
# `just observatory data`; run `just observatory tanstack-build` first.
tanstack-contract *args:
    node {{app_dir}}/perf/tanstack-contract.ts {{args}}

# The TanStack contender's JS from its release build, brotli: the
# first-paint JS (the entry and its static imports) and the data layer with
# Arrow (after first paint), each against perf/baseline.json (--check), and
# the engine's chunk, CSS, and HTML recorded. --label writes perf/results/;
# --write-baseline records both in perf/baseline.json. Run `just
# observatory tanstack-build` first.
tanstack-sizes *args:
    node {{app_dir}}/perf/tanstack-sizes.ts {{args}}

# The pinned DuckDB extensions into the TanStack contender's public/duckdb/.
tanstack-extensions:
    node {{root}}/engines/duckdb/web/scripts/extensions.ts {{tanstack_web}}/public duckdb

# The engine both contenders load: each build's duckdb/ byte-identical,
# both pages loading it from /observatory/duckdb/, the TanStack contender's
# JS past its entry requested after first paint, and whether the engine's
# JS chunk is shared (recorded). --controls: the comparison's and the
# first-paint rule's negative controls. --label writes perf/results/. Run
# `just observatory gpui-build` and `tanstack-build` first.
engine-files *args:
    node {{app_dir}}/perf/engine-files.ts {{args}}

# The GPUI contender's wasm built alone with and without `seiza`'s panel:
# raw and brotli sizes, and a check that the panel never links into the
# contender's own build (a feature leaking in through Cargo's unification),
# with the panel build as its negative control. --label: writes
# perf/results/<date>-<label>.json.
sizes *args:
    node {{app_dir}}/perf/sizes.ts {{args}}

# Lint, the GPUI contender's release build, the size check, then its
# budgets and checks on the build: reference TTFP against perf/baseline.json
# (perf/budgets.json's limits) and its wasm (brotli); the placeholder shell
# against the first frame; the file opened, the last row equal to count(*),
# and the contract published; the TanStack contender's build and the engine
# files both load, with their controls; then the fixtures. Needs `just
# observatory data`. Then the TanStack contender's JS budgets, its view
# (the last row in three browsers, the GPUI contender's column widths, a
# hidden page), its contract and first screen, and its parity with the
# tall table's input, tooltip, and focus. Then the page's build: its
# first paint and first-paint JS against the baseline, and how it hosts
# the contenders.
check: lint gpui-build tanstack-build build && fixtures
    node {{app_dir}}/perf/sizes.ts --check
    node {{app_dir}}/perf/tanstack-sizes.ts --check
    node {{app_dir}}/perf/cold.ts --check
    node {{app_dir}}/perf/placeholder.ts
    node {{app_dir}}/perf/reach.ts
    node {{app_dir}}/perf/engine-files.ts --controls
    node {{app_dir}}/perf/tanstack-view.ts --gpui
    node {{app_dir}}/perf/tanstack-contract.ts
    node {{app_dir}}/perf/tanstack-parity.ts
    node {{app_dir}}/perf/page.ts --check

# Cold load of the GPUI contender's release build (reference + throttled,
# median of 10): TTFP checked against its GPU calls, the placeholder's paint,
# nothing but the first-paint set before the first frame. Writes
# perf/results/<date>-<label>.json (--label, --runs, --reference-only,
# --write-baseline). Run `just observatory gpui-build` first.
cold *args:
    node {{app_dir}}/perf/cold.ts {{args}}

# The GPUI contender's placeholder shell against its first frame in
# screenshots (light and dark, DPR 2 and 1), and its characters. --controls:
# negative controls for the match. Run `just observatory gpui-build` first.
placeholder *args:
    node {{app_dir}}/perf/placeholder.ts {{args}}

# The tall table's fixtures (components/tall-table/fixtures/): their native
# tests in the component and the engine, each with its negative controls,
# the same fixtures and controls against the TanStack contender's data layer
# (node --test), and the cell fixture against what the GPUI contender's
# build draws: run
# `just observatory gpui-build` first (`check` does), or it checks the last
# build's drawing.
fixtures:
    cargo test -p seiza-tall-table fixtures
    cargo test -p seiza-duckdb --all-features sql_fixture
    npm test --workspace @seiza/observatory-tall-table-tanstack
    node {{app_dir}}/perf/cell-fixture.ts --check

# The tall table's cell fixture (components/tall-table/fixtures/cells.json)
# from the GPUI contender's release build: values picked from the data
# file by native DuckDB, the budgets and the text the contender draws.
# --check compares with the committed fixture. Needs `just observatory
# data`; run `just observatory gpui-build` first.
cell-fixture *args:
    node {{app_dir}}/perf/cell-fixture.ts {{args}}

# The GPUI contender on its release build: it opens the file, End reaches
# the last row (count(*) and the last key from native DuckDB), and it
# publishes the contract (marks in order, the filled mark right after a
# presented frame, usable confirmed by the probe key (and its control),
# state, targets, and the probe key only with ?measure, the marks relayed
# from a frame, the replay hooks). --label writes perf/results/. Needs
# `just observatory data`; run `just observatory gpui-build` first.
reach *args:
    node {{app_dir}}/perf/reach.ts {{args}}

# One per-use metric (metrics/metrics.ts computes it) on the bare
# contender pages' release builds, cold: usable (time to first usable,
# confirmed by the probe key; first pixels beside it), data (time to data),
# response (input to visible response: key, track press, wheel, each
# guarded), fling (behavior under load, per-frame work), reach (count(*)
# and the last row), cost (main-thread CPU, memory, bytes over a session).
# Flags: --side gpui|tanstack (default both, alternated), --runs (10),
# --profile reference|throttled (default both), --label (writes
# perf/results/), and response's --inputs (6 per kind). Run gpui-build and
# tanstack-build first; reach needs `just observatory data`.
metric name *args:
    node {{app_dir}}/perf/metric-{{name}}.ts {{args}}

# Build the data file (data/asteroids.parquet, gitignored) from Tycho's
# pinned asteroid sample (`just tycho data` first), and write
# data/MANIFEST.json. Installs data/'s native DuckDB (its own lockfile).
data:
    npm install --prefix {{app_dir}}/data --no-audit --no-fund --silent
    node {{app_dir}}/data/prep.ts

# Deploy to Cloudflare (seiza.io, the Worker in worker/): stage the data file
# and _headers into worker/dist/, `wrangler deploy` with the file's SHA-256 as
# DATA_SHA256 (the edge cache's key), then check production, retrying for a
# minute while the version reaches the edge. Needs `wrangler login`. Flags
# pass to the check, e.g. `--resolve-via 1.1.1.1`.
deploy *args:
    #!/usr/bin/env bash
    set -euo pipefail
    node {{app_dir}}/worker/scripts/stage.ts
    sha=$(node -e "console.log(JSON.parse(require('fs').readFileSync('{{app_dir}}/data/MANIFEST.json','utf8'))['asteroids.parquet'].sha256)")
    cd {{app_dir}}/worker && {{root}}/node_modules/.bin/wrangler deploy --var "DATA_SHA256:$sha"
    for attempt in $(seq 1 12); do
        node {{app_dir}}/worker/scripts/check.ts {{args}} && exit 0
        echo "check failed (attempt $attempt); retrying in 5 s"; sleep 5
    done
    exit 1

# The data file as production serves it: ranged HEAD and bytes=0-0 (206 with
# Content-Range), closed ranges byte-exact on the wire, no Content-Encoding,
# isolation headers and no-transform, the whole file's SHA-256. --url
# <origin> (default https://seiza.io), --resolve-via <dns server>.
worker-check *args:
    node {{app_dir}}/worker/scripts/check.ts {{args}}

# DuckDB-Wasm reading the data file in production next to Tycho's R2 path for
# the same rows (Chromium, a cold context per run, sides alternating): register,
# first page, the page at 90%, bytes read, count(*), and a digest of the first
# page both must share. Writes perf/results/<date>-<label>.json. Needs
# `just tycho build` (the page and engine it routes in). --runs, --label,
# --resolve-via.
data-read *args:
    node {{app_dir}}/perf/data-read.ts {{args}}

# The throwaway scroll spike (spike/: fake rows, no DuckDB): builds its page
# and drives it in Chromium, Firefox, and WebKit, writing
# perf/results/<date>-<label>-<scenario>.json. Installs spike/'s deps (its
# own lockfile). --only caps,reach,continuity,bar,tanstack,plain,latency,work
# (plain: plain TanStack, a native scroller over the full count, where it stops),
# --runs, --label, --browsers, --anchors, --variant, --stale, --sessions,
# --count, --no-build, --out (run.ts lists them). `latency` and `work` also
# drive Tycho's release build (`just tycho build` first), in Chromium. `spike-sizes`: its JS against React alone (--label).
spike *args:
    npm install --prefix {{app_dir}}/spike --no-audit --no-fund --silent
    node {{app_dir}}/spike/run.ts {{args}}

spike-sizes *args:
    npm install --prefix {{app_dir}}/spike --no-audit --no-fund --silent
    node {{app_dir}}/spike/sizes.ts {{args}}

# Regenerate the numbers in README.md, PLAN.md, and the root README from
# perf/budgets.json and the newest matching perf/results/ files. --check:
# report only.
report *args:
    cd {{root}} && node shared-web/scripts/report.ts apps/observatory {{args}}

# No milestone references outside the history files (check-terms), the
# generated numbers in the docs, fmt and clippy for the GPUI contender and for
# `seiza` without `panel`, as the contender builds it (wasm32 and native, with
# -D warnings), the site's surface grays against the contenders' theme.css
# (web/scripts/grays.ts), and TypeScript (site/ui, the page, the
# contenders' hosts and the TanStack contender's tests, the Worker and its
# scripts, perf/, and data/ and spike/ once their recipes installed their deps).
lint:
    cd {{root}} && node shared-web/scripts/check-terms.ts
    cd {{root}} && node shared-web/scripts/report.ts apps/observatory --check
    cargo fmt --all --check
    cargo run -q -p tall-table-gpui --example theme_css -- --check
    cargo clippy -p tall-table-gpui --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p tall-table-gpui --all-targets -- -D warnings
    cargo clippy -p seiza --no-default-features --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p seiza --no-default-features --all-targets -- -D warnings
    node {{page_web}}/scripts/grays.ts
    npm run typecheck --workspace @seiza/site-ui
    npm run typecheck --workspace @seiza/observatory-web
    npm run typecheck --workspace @seiza/observatory-tall-table-gpui
    npm run typecheck --workspace @seiza/observatory-tall-table-tanstack
    npm run typecheck --workspace @seiza/observatory-worker
    cd {{root}} && npx tsc -p apps/observatory/perf
    @if [ -d {{app_dir}}/data/node_modules ]; then cd {{root}} && npx tsc -p apps/observatory/data; else echo "skipped data/ typecheck: its deps install with \`just observatory data\`"; fi
    @if [ -d {{app_dir}}/spike/node_modules ]; then cd {{root}} && npx tsc -p apps/observatory/spike; else echo "skipped spike/ typecheck: its deps install with \`just observatory spike\`"; fi
