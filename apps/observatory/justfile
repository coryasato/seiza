# Observatory recipes. Run from the repo root: `just observatory <recipe>`.

app_dir := source_directory()
root := source_directory() / "../.."
gpui_web := app_dir / "contenders/tall-table/gpui/web"
tanstack_web := app_dir / "contenders/tall-table/tanstack/web"
target_dir := root / "target/wasm32-unknown-unknown"

page_web := app_dir / "web"
# The admin table's script faces, fetched by their pins (`script-fonts`).
fetch_fonts := "node " + app_dir / "contenders/fonts/fetch.ts"
# The GPUI contender's Cargo features at a level (`contenders/level.ts`'s `gpuiCargoFeatures`).
gpui_features := "node " + app_dir / "contenders/built.ts --cargo"

# The page's Vite dev server, with COOP/COEP, at /observatory/, the
# component's page, and each scenario's route. Its frames load the contenders' release builds
# (`gpui-build`, `tanstack-build` first), with the engine, the font, and
# the data file.
dev:
    npm run dev --workspace @seiza/observatory-web

# The page's release build (one prerendered HTML file per route), then
# asset sizes.
build:
    npm run build --workspace @seiza/observatory-web
    node {{root}}/shared-web/scripts/asset-sizes.ts {{page_web}}/dist

# Serve the page's release build (brotli), its frames' builds, the engine,
# the font, and the data, as the deploy will.
preview:
    npm run preview --workspace @seiza/observatory-web

# The page on its release build, with both contenders in its frames, in
# Chromium: first paint (paint timing) and its first-paint JS, cold,
# reference + throttled, median of 10; nothing but its HTML, CSS, entry, and
# font before first paint, the frame and the metrics module after it; the
# toggle disabled until the shown contender fills, a flip destroying the
# frame, ?side=, and the theme into both contenders live; each scenario's
# status bar, Compare panel, and description against perf/results/ (the
# wide sheet's at two stops, its panel's stops picking its cards' stop).
# --check: reference
# only, against perf/baseline.json (perf/budgets.json's limits); --runs,
# --label, --write-baseline, --reference-only. Run `just observatory
# gpui-build`, `tanstack-build`, and `build` first.
page *args:
    node {{app_dir}}/perf/page.ts {{args}}

# The GPUI contender (contenders/tall-table/gpui/): build its wasm (debug)
# and start its Vite dev server with COOP/COEP, at /observatory/. Serves the
# data files (`just observatory data`) by range at /observatory/data/.
# `level`: the feature level (contenders/scenarios.ts; `wide` at
# /observatory/contenders/tall-table/gpui/wide/).
gpui-dev level="base": (gpui-wasm "debug" level) gpui-extensions
    {{ if level == "base" { fetch_fonts } else { "true" } }}
    npm run dev --workspace @seiza/observatory-tall-table-gpui -- --mode {{ if level == "base" { "development" } else { level } }}

# The GPUI contender's release build at a feature level (`base`, `wide`, `market`):
# wasm (+ wasm-opt), Vite build into web/dist/ (the base) or
# web/dist-<level>/, then asset sizes. DuckDB's two wasm bundles are over
# Cloudflare's 25 MiB asset limit, so the deploy uploads only their brotli
# and gzip copies.
gpui-build level="base": (gpui-wasm "release" level) gpui-extensions
    npm run build --workspace @seiza/observatory-tall-table-gpui {{ if level == "base" { "" } else { "-- --mode " + level } }}
    node {{root}}/shared-web/scripts/asset-sizes.ts {{gpui_web}}/dist{{ if level == "base" { "" } else { "-" + level } }} --compressed duckdb-eh --compressed duckdb-mvp

# Serve the GPUI contender's release build at a level (brotli, as production will), with the data files.
gpui-preview level="base":
    {{ if level == "base" { fetch_fonts } else { "true" } }}
    npm run preview --workspace @seiza/observatory-tall-table-gpui {{ if level == "base" { "" } else { "-- --mode " + level } }}

# Compile the GPUI contender alone (`-p`: Cargo unifies features across the
# packages in one build), with the level's feature (the base's: `fonts`,
# the admin table's toggle; `contenders/level.ts`'s `gpuiCargoFeatures`), and
# generate its JS bindings into web/pkg/ (the base) or web/pkg-<level>/.
gpui-wasm profile="debug" level="base":
    cargo build -p tall-table-gpui --target wasm32-unknown-unknown {{ if profile == "release" { "--release" } else { "" } }} --features $({{gpui_features}} {{level}})
    wasm-bindgen {{target_dir}}/{{profile}}/tall_table_gpui.wasm --out-dir {{gpui_web}}/pkg{{ if level == "base" { "" } else { "-" + level } }} --target web
    {{ if profile == "release" { "wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals --enable-reference-types --enable-multivalue --enable-threads " + gpui_web + "/pkg" + (if level == "base" { "" } else { "-" + level }) + "/tall_table_gpui_bg.wasm -o " + gpui_web + "/pkg" + (if level == "base" { "" } else { "-" + level }) + "/tall_table_gpui_bg.wasm" } else { "true" } }}

# The admin table's script faces into contenders/fonts/faces/ (gitignored),
# served at /observatory/fonts/: each fetched by its pin and checked
# (contenders/fonts/faces.ts), with their license; anything else there
# removed. Only what serves or checks them runs it: the base level's
# gpui-dev and gpui-preview, admin, check, and deploy; no build needs them.
script-fonts:
    {{fetch_fonts}}

# Download the DuckDB extensions the engine pins into the GPUI contender's
# public/duckdb/ (served at /observatory/duckdb/), checking each SHA-256.
gpui-extensions:
    node {{root}}/engines/duckdb/web/scripts/extensions.ts {{gpui_web}}/public duckdb

# The TanStack contender (contenders/tall-table/tanstack/): its Vite dev
# server with COOP/COEP, at /observatory/contenders/tall-table/tanstack/
# (a level's under it: `wide`, `market`, `tail`), with the data files by range.
tanstack-dev level="base": tanstack-extensions
    npm run dev --workspace @seiza/observatory-tall-table-tanstack {{ if level == "base" { "" } else { "-- --mode " + level } }}

# The TanStack contender's release build at a feature level (`base`,
# `wide`, `market`, `tail`) into web/dist/ or web/dist-<level>/, then asset sizes. DuckDB's
# bundles and extensions land in its duckdb/, the same files as the GPUI
# contender's (`engine-files` checks it). The build fails if Arrow or
# DuckDB's JS reaches a first-paint chunk (contenders/engine.ts).
tanstack-build level="base": tanstack-extensions
    npm run build --workspace @seiza/observatory-tall-table-tanstack {{ if level == "base" { "" } else { "-- --mode " + level } }}
    node {{root}}/shared-web/scripts/asset-sizes.ts {{tanstack_web}}/dist{{ if level == "base" { "" } else { "-" + level } }} --compressed duckdb-eh --compressed duckdb-mvp

# Serve the TanStack contender's release build at a level (brotli), with the data files.
tanstack-preview level="base":
    npm run preview --workspace @seiza/observatory-tall-table-tanstack {{ if level == "base" { "" } else { "-- --mode " + level } }}

# The TanStack contender's theme (tanstack/web/src/theme.css): the colors
# the tall table draws with, as CSS variables, light and dark, generated
# natively from gpui-kit's default theme at the pin. --check fails if the
# committed file differs.
theme-css *args:
    cargo run -q -p tall-table-gpui --example theme_css -- {{args}}

# The TanStack contender's view on its release build: it opens the file
# and End reaches the last row (its number count(*), its key the file's
# last, from native DuckDB) in Chromium, Firefox, and WebKit; the engine
# starts in a hidden frame and a hidden page. --gpui compares the columns
# with the GPUI contender's build; --shots <dir> writes screenshots;
# --browsers, --label. Needs `just observatory data`; run `just
# observatory tanstack-build` first.
tanstack-view *args:
    node {{app_dir}}/perf/tanstack-view.ts {{args}}

# The TanStack contender's base-level parity with the tall table, item by
# item against the component's README, on its release build (`?probe`):
# the keys (and the GPUI contender's, the same keys), Shift+wheel, a track
# press, the drag settle, the tooltip, and the focus ring, in Chromium,
# Firefox, and WebKit; at the wide level the pinned edge and the sideways
# scroll; at the market level the sign colors and the flash (its colors,
# its columns, its fade ending), light and dark; at the tail level
# following, letting go on a wheel up, coming back at End and at a wheel
# to the end, the time muted and an error status's color, light and
# dark. --firefox adds a headed
# Firefox's track press (classic scrollbars); --browsers, --label. Needs
# `just observatory data`; run `just observatory builds` first.
tanstack-parity *args:
    node {{app_dir}}/perf/tanstack-parity.ts {{args}}

# The TanStack contender on its release build: its prerendered first
# screen hydrated in place, first usable confirmed by the probe key (and its
# control: a key before the hydration commit changes nothing), and the
# contract (marks in order, the engine started after first paint and
# usable, each filled mark's cells painted right after it, state, targets,
# and Element Timing only with ?measure, the replay hooks, the marks
# relayed from a frame), in Chromium; and at the market level (the feed's
# batches in order, the refreshed marks, the feed ended by a reopen, only
# with ?measure) and the tail level (the clock's messages in order, the
# tail marks rising, the pause, the replay's jump letting go and its fling
# following again, a reopen starting the replay over, only with
# ?measure). --label writes perf/results/. Needs `just observatory data`;
# run `just observatory tanstack-build`, `tanstack-build market`, and
# `tanstack-build tail` first.
tanstack-contract *args:
    node {{app_dir}}/perf/tanstack-contract.ts {{args}}

# The TanStack contender's JS from its release build, brotli: the
# first-paint JS (the entry and its static imports) and the data layer with
# Arrow (after first paint), each against perf/baseline.json (--check), and
# the engine's chunk, CSS, and HTML recorded (and the feed's worker on the
# market level, the clock's on the tail level). --level wide|market|tail: that build, against its own baseline
# (perf/baseline.json's `levels`), label tanstack-sizes-<level>. --label
# writes perf/results/; --write-baseline records both in
# perf/baseline.json. Run `just observatory tanstack-build` (and
# `tanstack-build <level>`) first.
tanstack-sizes *args:
    node {{app_dir}}/perf/tanstack-sizes.ts {{args}}

# The pinned DuckDB extensions into the TanStack contender's public/duckdb/.
tanstack-extensions:
    node {{root}}/engines/duckdb/web/scripts/extensions.ts {{tanstack_web}}/public duckdb

# The engine both contenders load: each build's duckdb/ byte-identical
# (every level's too),
# both pages loading it from /observatory/duckdb/, the TanStack contender's
# JS past its entry requested after first paint, and whether the engine's
# JS chunk is shared (recorded). --controls: the comparison's and the
# first-paint rule's negative controls. --label writes perf/results/. Run
# `just observatory gpui-build` and `tanstack-build` first.
engine-files *args:
    node {{app_dir}}/perf/engine-files.ts {{args}}

# The GPUI contender's wasm built alone with and without `seiza`'s panel:
# raw and brotli sizes, and a check that the panel never links into the
# contender's own build (a feature leaking in through Cargo's unification),
# with the panel build as its negative control. --label: writes
# perf/results/<date>-<label>.json.
sizes *args:
    node {{app_dir}}/perf/sizes.ts {{args}}

# The GPUI contender's page by part, brotli: its HTML (the placeholder's
# inlined font, the rest), its JS (wasm-bindgen's glue, the rest), and its
# wasm by crate (framework, component, data layer, host, runtime, static
# data), from a release build with its names kept. --label: writes
# perf/results/<date>-<label>.json. Run `just observatory gpui-build` first.
gpui-parts *args:
    node {{app_dir}}/perf/gpui-parts.ts {{args}}

# Every contender build: each level each side builds
# (contenders/scenarios.ts's `BUILT`: `gpui-build <level>`, `tanstack-build
# <level>`), then the page's `build`.
builds:
    #!/usr/bin/env bash
    set -euo pipefail
    for side in gpui tanstack; do
      # Read first: a failing substitution in a `for` list escapes `set -e`.
      levels=$(node {{app_dir}}/contenders/built.ts $side)
      for level in $levels; do
        {{just_executable()}} --justfile {{root}}/justfile observatory $side-build $level
      done
    done
    {{just_executable()}} --justfile {{root}}/justfile observatory build

# Lint, every build (`builds`), the size check, then its
# budgets and checks on the build: reference TTFP against perf/baseline.json
# (perf/budgets.json's limits) and its wasm (brotli); the placeholder shell
# against the first frame; the file opened, the last row equal to count(*),
# and the contract published; the TanStack contender's build and the engine
# files both load, with their controls; then the fixtures. Needs `just
# observatory data`. Then the TanStack contender's JS budgets, its view
# (the last row in three browsers, the GPUI contender's column widths, a
# hidden page), its contract and first screen, and its parity with the
# tall table's input, tooltip, and focus. Then the page's build: its
# first paint and first-paint JS against the baseline, and how it hosts
# the contenders.
check: lint builds script-fonts && fixtures
    node {{app_dir}}/perf/sizes.ts --check
    levels=$(node {{app_dir}}/contenders/built.ts tanstack) && for level in $levels; do node {{app_dir}}/perf/tanstack-sizes.ts --level $level --check || exit 1; done
    levels=$(node {{app_dir}}/contenders/built.ts gpui) && for level in $levels; do node {{app_dir}}/perf/cold.ts --level $level --check || exit 1; done
    node {{app_dir}}/perf/wide.ts
    node {{app_dir}}/perf/market.ts
    node {{app_dir}}/perf/tail.ts
    node {{app_dir}}/perf/admin.ts
    levels=$(node {{app_dir}}/contenders/built.ts gpui) && for level in $levels; do node {{app_dir}}/perf/placeholder.ts --level $level || exit 1; done
    node {{app_dir}}/perf/reach.ts
    node {{app_dir}}/perf/engine-files.ts --controls
    node {{app_dir}}/perf/tanstack-view.ts --gpui
    node {{app_dir}}/perf/tanstack-contract.ts
    node {{app_dir}}/perf/tanstack-parity.ts
    node {{app_dir}}/perf/page.ts --check

# Cold load of the GPUI contender's release build (reference + throttled,
# median of 10): TTFP checked against its GPU calls, the placeholder's paint,
# nothing but the first-paint set before the first frame. Writes
# perf/results/<date>-<label>.json (--label, --runs, --reference-only,
# --write-baseline). Run `just observatory gpui-build` first.
cold *args:
    node {{app_dir}}/perf/cold.ts {{args}}

# The GPUI contender's placeholder shell against its first frame in
# screenshots (light and dark, DPR 2 and 1), and its characters. --controls:
# negative controls for the match. Run `just observatory gpui-build` first.
placeholder *args:
    node {{app_dir}}/perf/placeholder.ts {{args}}

# The tall table's fixtures (components/tall-table/fixtures/): their native
# tests in the component and the engine, each with its negative controls,
# the same fixtures and controls against the TanStack contender's data layer
# (node --test), and the cell fixture against what the GPUI contender's
# build draws: run
# `just observatory gpui-build` first (`check` does), or it checks the last
# build's drawing. And market watch's feed fixture
# (contenders/market/fixtures/feed.json): the feed regenerating it, then
# each side's store against it with its controls (the GPUI contender's
# natively, the TanStack contender's in its `npm test`). And live tail's:
# its clock's fixture (contenders/tail/fixtures/clock.json), then each
# side's loop SQL and time text against sql.json and cells.json.
fixtures:
    cargo test -p seiza-tall-table fixtures
    cargo test -p seiza-tall-table --features custom-cells,pin,density fixtures
    cargo test -p seiza-duckdb --all-features sql_fixture
    node {{app_dir}}/contenders/market/fixtures/write.ts --check
    node --test {{app_dir}}/contenders/tail/fixtures/clock.test.ts
    cargo test -p tall-table-gpui --features market -- market:: tail::
    cargo test -p tall-table-gpui --features tail scene::tail::
    npm test --workspace @seiza/observatory-tall-table-tanstack
    node {{app_dir}}/perf/cell-fixture.ts --check

# The tall table's cell fixture (components/tall-table/fixtures/cells.json)
# from the GPUI contender's release build: values picked from the data
# file by native DuckDB, the budgets and the text the contender draws.
# --check compares with the committed fixture. Needs `just observatory
# data`; run `just observatory gpui-build` first.
cell-fixture *args:
    node {{app_dir}}/perf/cell-fixture.ts {{args}}

# The GPUI contender on its release build: it opens the file, End reaches
# the last row (count(*) and the last key from native DuckDB), and it
# publishes the contract (marks in order, the filled mark right after a
# presented frame, usable confirmed by the probe key (and its control),
# state, targets, and the probe key only with ?measure, the marks relayed
# from a frame, the replay hooks). --label writes perf/results/. Needs
# `just observatory data`; run `just observatory gpui-build` first.
reach *args:
    node {{app_dir}}/perf/reach.ts {{args}}

# One per-use metric (metrics/metrics.ts computes it) on the bare
# contender pages' release builds, cold: usable (time to first usable,
# confirmed by the probe key; first pixels beside it), data (time to data),
# response (input to visible response: key, track press, wheel, each
# guarded), fling (behavior under load, per-frame work), reach (count(*)
# and the last row), cost (main-thread CPU, memory, bytes over a session),
# memory (at equal work: the same pages read on both devices; each file's
# bytes on the wire; market watch's: the feed to a fixed tick count), the
# wide sheet's scroll (keeps up: at each stop, the file read whole, then the
# gesture scroll down, sideways, and fast), and market watch's feed (at each
# stop, 10 s traced under the feed: keeps up, Shown in, collection pauses,
# late frames, work), live tail's tail (at each stop, 10 s traced under the
# replay: Row shown in and keeps up, late frames, work, collections; then
# the scroll back and its control) and soak (at 100k for --minutes, 10: a
# window at the start and the end, memory after each; memory at the tail
# level: the replay to a fixed row count).
# Flags: --side gpui|tanstack (default both, alternated), --runs (10),
# --profile reference|throttled (default both), --label (writes
# perf/results/), --scenario <id> (on its level's builds; default the base's
# Big file) and --stop <id,…|all> (default its default stop; scroll's,
# feed's, and tail's, all; soak's, 100k: each stop's file
# <label>-<scenario>-<stop>), response's --inputs (6 per kind), and soak's
# --minutes. Run gpui-build and tanstack-build (at the scenario's level) first;
# reach and memory need `just observatory data`.
metric name *args:
    node {{app_dir}}/perf/metric-{{name}}.ts {{args}}

# What the page's live readouts cost the contender they watch: each side
# flung cold in four variants (the page with the meter open, a pill, or
# hidden, and the bare contender page), interleaved by round, reference and
# throttled (its network through a shaping proxy, which reaches the frame's
# worker; Chromium's own doesn't). Gated: each variant's spread, late frames
# open and bare against hidden, TanStack's dropped frames and GPUI's
# GPU-process time open against hidden, the page's own time per refresh, no
# React commit from the page mid-fling (and its control), no software
# renderer. Flags: --runs (10), --side, --profile, --variants, --headed,
# --label. Run gpui-build, tanstack-build, and build first.
readout-cost *args:
    node {{app_dir}}/perf/readout-cost.ts {{args}}

# Build the data files (gitignored) and write data/MANIFEST.json:
# asteroids.parquet from Tycho's pinned asteroid sample (`just tycho data`
# first), ghcn-2025-tmax.parquet from NOAA's GHCN-Daily, its sources kept in
# data/raw/ghcn/ and checked against their pins (a missing one downloaded),
# market-instruments.parquet from the feed's instruments
# (contenders/market/feed.ts; it fails if a symbol is listed on a US
# exchange, NASDAQ Trader's directories fetched), and
# nasa-http-jul95.parquet from NASA-HTTP's July 1995 log, kept in
# data/raw/nasa/ and checked against its pin (downloaded when missing), with
# the replay's pages run against it, and countries.parquet from CLDR's
# region names and populations and Wikidata's capitals, kept in
# data/raw/countries/ and checked against their pins (downloaded when
# missing). Installs data/'s native DuckDB (its own lockfile). Flags:
# --only asteroids|ghcn|market|nasa|countries; --repin (download GHCN's
# sources and the Wikidata query's result again and pin them: a new file,
# so regenerate cells.json).
data *args:
    npm install --prefix {{app_dir}}/data --no-audit --no-fund --silent
    node {{app_dir}}/data/prep.ts {{args}}

# Deploy to Cloudflare (seiza.io, the Worker in worker/): build the page and
# both contenders, stage them, the engine, the font, and the data into
# worker/dist/ with a quality-11 .br beside each build file
# (worker/scripts/stage.ts), `wrangler deploy` with the data file's SHA-256 as
# DATA_FILES (each data file's SHA-256, its edge-cache key), then check production once the edge
# serves the new routes' HTML (polled for a minute: `--wait`; a deploy that
# changes only the Worker's code can't be told apart that way, so rerun
# `worker-check` if that check fails). Needs `wrangler login`. Flags pass to
# the check, e.g. `--resolve-via 1.1.1.1`, `--behind-waf`.
deploy *args: builds script-fonts
    #!/usr/bin/env bash
    set -euo pipefail
    node {{app_dir}}/worker/scripts/stage.ts
    files=$(node {{app_dir}}/worker/scripts/staged.ts --data-files)
    cd {{app_dir}}/worker && WRANGLER_SEND_METRICS=false {{root}}/node_modules/.bin/wrangler deploy --var "DATA_FILES:$files"
    node {{app_dir}}/worker/scripts/check.ts --wait {{args}}

# Production as the Worker serves it, against the staged worker/dist/: every
# build file at its path (each route at its URL), with the isolation
# headers, its type and Cache-Control, and exactly the staged quality-11 .br
# on the wire; the routes' HTML without br exactly the build's (nothing
# injected); DuckDB's oversize wasm as its .gz without br; a revalidation's
# 304, the routes' redirects, a 404. The data: ranged HEAD and bytes=0-0
# (206 with Content-Range), closed ranges byte-exact on the wire, no
# Content-Encoding, isolation headers and no-transform, the whole file's
# SHA-256. --url <origin> (default https://seiza.io), --resolve-via <dns
# server>, --behind-waf (a probe and a POST get the WAF's 403), --data-only.
worker-check *args:
    node {{app_dir}}/worker/scripts/check.ts {{args}}

# Both contenders at the wide level, on their release builds: at each of
# the wide sheet's stops the layout it asks for (rows, the days' width, the
# key columns pinned), heat on every day with a value and nothing else, the
# top rows as native DuckDB has them, and the cells on screen against the
# stop's label; the TanStack side's layout GPUI's, column for column, and
# its heat's pixels the ramp's; an unknown stop or scenario, and the wide
# sheet asked of the base build, fail the load; the base still opens Big
# file. --side gpui|tanstack (GPUI's layout is read either way), --label
# writes perf/results/. Run `gpui-build`, `gpui-build wide`,
# `tanstack-build`, and `tanstack-build wide` first.
wide *args:
    node {{app_dir}}/perf/wide.ts {{args}}

# Both contenders at the market level, on their release builds, the same
# checks each: the feed's fold of the fixture's 2,000 ticks drawn (every
# cell's exact and shown text, the sign colors, no flash left; light and
# dark), its control one tick short; the flash under the feed on Last, Bid,
# and Ask alone; Shown in's marks at each stop (GPUI's right after a
# presented frame, TanStack's in a frame's callback; each visible batch
# drawn); an unknown stop or scenario, `?ticks` that isn't a count, and
# market watch on the base build fail the load; and both sides' columns
# and cells the same. --side gpui|tanstack, --label. Run `builds` first
# (each side's base and market builds).
market *args:
    node {{app_dir}}/perf/market.ts {{args}}

# Both contenders at the tail level, on their release builds: the replay's cells past a lap at the top
# stop, the clock paused (the tail, a lap's seam, the first rows: each
# cell against native DuckDB's row of the file, the time the log's text
# moved on by its laps and muted, an error status in the error color, the
# bytes grouped; the columns at the scenario's widths; light and dark;
# the controls, no lap's shift and the kinds' widths); the tail
# marks right after presented frames (GPUI) or set in a frame's callback
# (TanStack), each clock message reached, its counts the rate's; a wheel
# up letting go and holding, End following again; nothing logged without
# ?measure; a replay open starting over; the worker or the whole file 404
# failing the view; an unknown stop or scenario, and live tail on the base
# build, failing the load; both sides' cells at a seam and the first rows
# the same, and their columns. --side, --label. Run `builds` first.
tail *args:
    node {{app_dir}}/perf/tail.ts {{args}}

# The admin table's capabilities on both contenders' base builds, each with
# its control: find, a drag's selection and the copy, the accessibility
# tree, every script drawn (TanStack's platform faces; GPUI's pixels against
# the DOM's drawing in the same face, by default and with `?fonts`), the
# flags, Translate's precondition; the fonts path's fetches and marks; the
# TanStack side's drawn text against cells.json's (--side, --label, --shots
# <dir>). Run `gpui-build` and `tanstack-build` first.
admin *args: script-fonts
    node {{app_dir}}/perf/admin.ts {{args}}

# Request bursts on the page's release build: the most requests one visitor
# sends in any 10 s (the zone's rate limit's window), counted at the server
# while the replay hooks fling and jump each side (on the wide sheet, at
# every stop of the dial), market watch's and live tail's every stop on each
# side under its feed, the admin table's GPUI side with its fonts toggle
# pressed and pressed again, Big file then the wide sheet, and over 5 reloads
# of each route. Writes perf/results/<date>-<label>.json. --label, --only
# visit,reloads,wide,both,wide-reloads,market,market-reloads,tail,tail-reloads,
# admin,admin-reloads.
# Run `builds` first.
burst *args:
    node {{app_dir}}/perf/burst.ts {{args}}

# The tab's memory over a scripted session on the page: every route, each
# stop on both sides (a flip and back), then the Overview idle; at each step
# the tab's breakdown, which destroyed frames' documents, wasm memories, and
# workers are still alive, and the renderer's and GPU process's footprint.
# Writes perf/results/<date>-<label>.json. --gc (a forced collection before
# every reading), --dwell 5, --idle-minutes 10, --label. Run `builds` first.
session-memory *args:
    node {{app_dir}}/perf/session-memory.ts {{args}}

# DuckDB-Wasm reading the data file in production next to Tycho's R2 path for
# the same rows (Chromium, a cold context per run, sides alternating): register,
# first page, the page at 90%, bytes read, count(*), and a digest of the first
# page both must share. Writes perf/results/<date>-<label>.json. Needs
# `just tycho build` (the page and engine it routes in). --runs, --label,
# --resolve-via.
data-read *args:
    node {{app_dir}}/perf/data-read.ts {{args}}

# The throwaway scroll spike (spike/: fake rows, no DuckDB): builds its page
# and drives it in Chromium, Firefox, and WebKit, writing
# perf/results/<date>-<label>-<scenario>.json. Installs spike/'s deps (its
# own lockfile). --only caps,reach,continuity,bar,tanstack,plain,latency,work
# (plain: plain TanStack, a native scroller over the full count, where it stops),
# --runs, --label, --browsers, --anchors, --variant, --stale, --sessions,
# --count, --no-build, --out (run.ts lists them). `latency` and `work` also
# drive Tycho's release build (`just tycho build` first), in Chromium. `spike-sizes`: its JS against React alone (--label).
spike *args:
    npm install --prefix {{app_dir}}/spike --no-audit --no-fund --silent
    node {{app_dir}}/spike/run.ts {{args}}

spike-sizes *args:
    npm install --prefix {{app_dir}}/spike --no-audit --no-fund --silent
    node {{app_dir}}/spike/sizes.ts {{args}}

# Regenerate the numbers in README.md, PLAN.md, and the root README from
# perf/budgets.json and the newest matching perf/results/ files. --check:
# report only.
report *args:
    cd {{root}} && node shared-web/scripts/report.ts apps/observatory {{args}}

# No milestone references outside the history files (check-terms), the
# generated numbers in the docs, fmt and clippy for the GPUI contender and for
# `seiza` without `panel`, as the contender builds it (wasm32 and native, with
# -D warnings), the site's surface grays against the contenders' theme.css
# (web/scripts/grays.ts), and TypeScript (site/ui, the page, the
# contenders' hosts and the TanStack contender's tests, the Worker and its
# scripts, perf/, and data/ and spike/ once their recipes installed their deps).
lint:
    cd {{root}} && node shared-web/scripts/check-terms.ts
    cd {{root}} && node shared-web/scripts/report.ts apps/observatory --check
    cargo fmt --all --check
    cargo run -q -p tall-table-gpui --example theme_css -- --check
    cargo clippy -p tall-table-gpui --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p tall-table-gpui --features $({{gpui_features}} base) --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p tall-table-gpui --all-targets -- -D warnings
    cargo clippy -p tall-table-gpui --features wide --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p tall-table-gpui --features wide --all-targets -- -D warnings
    cargo clippy -p tall-table-gpui --features market --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p tall-table-gpui --features market --all-targets -- -D warnings
    cargo clippy -p tall-table-gpui --features tail --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p tall-table-gpui --features tail --all-targets -- -D warnings
    cargo clippy -p seiza --no-default-features --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p seiza --no-default-features --all-targets -- -D warnings
    cargo clippy -p seiza --no-default-features --features canvas-font-fallback --target wasm32-unknown-unknown -- -D warnings
    node {{page_web}}/scripts/grays.ts
    npm run typecheck --workspace @seiza/site-ui
    npm run typecheck --workspace @seiza/observatory-web
    npm run typecheck --workspace @seiza/observatory-tall-table-gpui
    npm run typecheck --workspace @seiza/observatory-tall-table-tanstack
    npm run typecheck --workspace @seiza/observatory-worker
    cd {{root}} && npx tsc -p apps/observatory/perf
    @if [ -d {{app_dir}}/data/node_modules ]; then cd {{root}} && npx tsc -p apps/observatory/data; else echo "skipped data/ typecheck: its deps install with \`just observatory data\`"; fi
    @if [ -d {{app_dir}}/spike/node_modules ]; then cd {{root}} && npx tsc -p apps/observatory/spike; else echo "skipped spike/ typecheck: its deps install with \`just observatory spike\`"; fi
