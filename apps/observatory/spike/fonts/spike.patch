     let (frames, filled) = VIEW.get();
     vec![frames.into(), if filled { 1.0 } else { 0.0 }]
 }
+
+// SPIKE (the fonts spike, deleted with spike/): fonts added after first
+// paint, then the window redrawn; `spike:fonts-drawn` right after the frame
+// that draws with them.
+thread_local! {
+    /// SPIKE: route 2's fallback list, once its faces are in.
+    pub static SPIKE_FALLBACKS: RefCell<Option<FontFallbacks>> = const { RefCell::new(None) };
+}
+
+#[wasm_bindgen(js_name = spikeAddFonts)]
+pub fn spike_add_fonts(fonts: Vec<js_sys::Uint8Array>, fallbacks: Vec<String>) {
+    let Some((host, window, mut cx)) = HOST.with_borrow(Clone::clone) else {
+        return;
+    };
+    let fonts: Vec<std::borrow::Cow<'static, [u8]>> =
+        fonts.iter().map(|font| std::borrow::Cow::Owned(font.to_vec())).collect();
+    seiza::marks::mark("spike:fonts-in");
+    let _ = window.update(&mut cx, move |_, window, cx| {
+        if let Err(error) = cx.text_system().add_fonts(fonts) {
+            web_log(&format!("spike: add_fonts failed: {error:#}"));
+        }
+        if !fallbacks.is_empty() {
+            SPIKE_FALLBACKS.set(Some(FontFallbacks::from_fonts(fallbacks)));
+        }
+        let _ = host.update(cx, |_, cx| cx.notify());
+        let text = "\u{0DC1}\u{0DCA}\u{200D}\u{0DBB}\u{0DD3} \u{0DBD}\u{0D82}\u{0D9A}\u{0DCF}\u{0DC0}";
+        for fallbacks in [None, SPIKE_FALLBACKS.with_borrow(Clone::clone)] {
+            let mut font = window.text_style().font();
+            font.fallbacks = fallbacks.clone();
+            web_log(&format!("spike: font_id {:?}", cx.text_system().resolve_font(&font)));
+            let run = TextRun { len: text.len(), font, color: gpui_kit::black(), background_color: None, underline: None, strikethrough: None };
+            let line = window.text_system().shape_line(text.into(), px(14.), &[run], None);
+            let runs: Vec<_> = line.runs.iter().map(|r| (r.font_id, r.glyphs.iter().map(|g| (g.id.0, g.index)).collect::<Vec<_>>())).collect();
+            web_log(&format!("spike: fallbacks {} width {:?} runs {:?}", fallbacks.is_some(), line.width, runs));
+        }
+        window.on_next_frame(|_, _| {
+            let _ = seiza::marks::mark_after_current_task("spike:fonts-drawn");
+        });
+        window.refresh();
+    });
+}
+
+fn web_log(text: &str) {
+    let console = js_sys::Reflect::get(&js_sys::global(), &"console".into()).unwrap();
+    let log: js_sys::Function = js_sys::Reflect::get(&console, &"log".into()).unwrap().into();
+    let _ = log.call1(&console, &text.into());
+}
