# Kirkwood's recipes. Run from the repo root: `just kirkwood <recipe>`.
# A showcase: no check, perf, or report (root CLAUDE.md, "Tiers"). The data's
# own commands are in docs/data.md.

app_dir := source_directory()
root := source_directory() / "../.."
web := app_dir / "web"
pkg := web / "pkg"
target_dir := root / "target/wasm32-unknown-unknown"

# Build the wasm (debug) and start the Vite dev server with COOP/COEP. The
# files come from data/ (data/prep.ts builds the two the crate holds,
# data/stars.ts the sky's).
dev: (wasm "debug")
    npm run dev --workspace @seiza/kirkwood-web

# Release wasm (+ wasm-opt), Vite build, then the asset sizes.
build: (wasm "release")
    npm run build --workspace @seiza/kirkwood-web
    node {{root}}/shared-web/scripts/asset-sizes.ts {{web}}/dist

# Serve the release build with the same headers, and data/'s files.
preview:
    npm run preview --workspace @seiza/kirkwood-web

# Serve the release build behind the app's Worker under `wrangler dev`, at
# http://127.0.0.1:8788/: the build's files as their quality-11
# `.br`, the three files from Miniflare's R2 (filled here, and compressed
# the first time: a minute or two a file). --paused: with the pause on. Run
# `just kirkwood build` first.
worker *args:
    node {{app_dir}}/worker/scripts/dev.ts {{args}}

# Deploy to Cloudflare: release build, then the bucket's objects whose file
# changed, `wrangler deploy`, and the checks against production
# (worker/scripts/deploy.ts). Needs `wrangler login`, the bucket, made once
# (the script's header), and the zone's rules for the hostname. Flags:
# --dry-run, --skip-check, --prune (deletes earlier files' objects, after the
# check).
deploy *args: build
    node {{app_dir}}/worker/scripts/deploy.ts {{args}}

# Production: pause the three files. Each answers 503 and nothing reads R2;
# the page still loads and says the data is paused. A Worker secret
# (DATA_PAUSED): it takes effect in seconds and survives deploys. Kirkwood's
# Worker alone: Tycho has its own switch (`just tycho pause`). Needs
# `wrangler login`.
pause: (paused "1")

# Production: serve the three files again after `just kirkwood pause`.
resume: (paused "0")

# DATA_PAUSED on Kirkwood's Worker.
[private]
paused value:
    cd {{app_dir}}/worker && printf {{value}} | {{root}}/node_modules/.bin/wrangler secret put DATA_PAUSED

# Production against web/dist and data/: every file the page asks for, its
# bytes and its encoding on the wire, what's never served, the WAF's 403s,
# and the old address's redirect (worker/scripts/check.ts). Needs the build that was deployed.
# Flags: --url <origin>, --no-waf, --whole.
deployed *args:
    node {{app_dir}}/worker/scripts/check.ts {{args}}

# The Gaia sample the sky is built from, data/gaia-dr3-bright.parquet, and
# its manifest entry (data/gaia.ts), then the sky, data/stars.bin, from it
# (data/stars.ts). The first run reads ~90 GB from AWS Open Data
# (docs/data.md), keeping its extracts in data/raw/gaia/; a rerun reads
# nothing. Flags go to gaia.ts: --check (both scripts build again and fail
# unless the bytes are the manifest's; nothing kept), --refresh, --jobs,
# --cut. Installs native DuckDB (data/package.json, its own lockfile) first.
gaia *args:
    npm install --prefix {{app_dir}}/data --no-audit --no-fund --silent
    node {{app_dir}}/data/gaia.ts {{args}}
    node {{app_dir}}/data/stars.ts {{ if args =~ "--check" { "--check" } else { "" } }}

# Compile the crate alone (`-p`: Cargo unifies features across the packages
# in one build) and generate its JS bindings into web/pkg/.
wasm profile="debug":
    cargo build -p kirkwood --target wasm32-unknown-unknown {{ if profile == "release" { "--release" } else { "" } }}
    wasm-bindgen {{target_dir}}/{{profile}}/kirkwood.wasm --out-dir {{pkg}} --target web
    {{ if profile == "release" { "wasm-opt -Oz --enable-bulk-memory --enable-nontrapping-float-to-int --enable-sign-ext --enable-mutable-globals --enable-reference-types --enable-multivalue --enable-threads " + pkg + "/kirkwood_bg.wasm -o " + pkg + "/kirkwood_bg.wasm" } else { "true" } }}

# Native tests: the clock and its reach, the files' rules, Jupiter against
# data/horizons.json, the integration's steps. And, `#[ignore]`d in a plain
# `cargo test` and run here (about two minutes; they read data/elements.bin
# and data/rows.bin, and fail without them): the files against the manifest,
# the readers against data/fixture.json (and that a wrong cell fails), five
# rows against Horizons, the Trojans by a and e against the rows of class
# TJN, a live cell against the row's place at the instant shown, the
# integration against Horizons and the Trojans in their clouds across the
# clock's reach, the shader's 32-bit arithmetic against the 64-bit place for
# every row, and its flight against the place on the axes for every row in
# view. The two studies are no-ops without KIRKWOOD_STUDY. Then the
# Worker's unit tests, against a fake bucket and fake static assets.
test:
    cargo test -p kirkwood -- --include-ignored
    node --test {{app_dir}}/worker/test/index.test.ts

# What the release build shows, in headless Chromium (checks/see.ts): the
# first frame before either file is asked for, the table over the rows
# file, the wasm's memory against the files' bytes, the belt, the time
# control, the look, the legend, the sky, the camera a hand moves, its compass, hint, and keys, the sort flight, the ride with Jupiter, a gap picked, the integrated rows, a row found, a group drawn, its flight in, a dot clicked, the live columns, a sort as a tour, fingers on the scene, the scene's resolution as the visitor's, a lost WebGL context given back, and a phone's page. Screenshots and seen.json in
# checks/out/ (gitignored); about 30 minutes. --only paint,table,memory,belt,time,bodies,look,color,sky,wheel,camera,tilt,corner,sort,ride,gap,integrated,find,group,flyin,dot,live,tour,touch,scale,lost,phone; --runs.
# Asked for by name alone: --only rate (the scene's frames a second), drag
# (a drag's frames a second), slow (a load on a slow link), cross (--browser
# firefox|webkit, with wheel), glass (the panel as glass over a group),
# stills (the phone's page's pictures, into web/public/phone/),
# paused (alone: the page with the data paused, behind the Worker).
# --worker: behind the app's Worker under `wrangler dev`, not `vite preview`
# (every part but slow). --url <the page>: one served elsewhere (production),
# paint or paused alone. Run `just kirkwood build` first.
see *args:
    node {{app_dir}}/checks/see.ts {{args}}

# check-terms, fmt, clippy (wasm target and native), TypeScript (the host,
# the checks, the data's scripts, the Worker, its scripts and tests).
lint:
    cd {{root}} && node shared-web/scripts/check-terms.ts
    cargo fmt --all --check
    cargo clippy -p kirkwood --target wasm32-unknown-unknown -- -D warnings
    cargo clippy -p kirkwood --all-targets -- -D warnings
    npm run typecheck --workspace @seiza/kirkwood-web
